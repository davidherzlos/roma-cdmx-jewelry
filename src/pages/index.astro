---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/components/TopBar.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import TrustBar from '@/components/TrustBar.astro';
import Catalog from '@/components/Catalog.astro';
import History from '@/components/History.astro';
import Clients from '@/components/Clients.astro';
import Services from '@/components/Services.astro';
import Visit from '@/components/Visit.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import MobileActions from '@/components/MobileActions.astro';
import { ui } from '@/data/content';
---

<Layout>
  <div class="relative overflow-clip bg-bg text-ink">
    <a href="#contenido" class="skip-link">{ui.skipLink}</a>
    <TopBar />
    <Header />
    <main id="contenido" tabindex="-1" class="outline-none">
      <Hero />
      <TrustBar />
      <Catalog />
      <History />
      <Clients />
      <Services />
      <Visit />
      <Contact />
    </main>
    <Footer />
    <MobileActions />
  </div>
</Layout>
