---
import Layout from '@/layouts/Layout.astro';
import { site } from '@/config/site';
import { privacy, ui } from '@/data/content';
---

<Layout title={`${privacy.title} · ${site.name}`}>
  <a href="#contenido" class="skip-link">{ui.skipLink}</a>
  <main id="contenido" class="container-site min-h-screen py-16 md:py-24">
    <a href="/" class="inline-flex min-h-11 items-center font-bold">← {privacy.back}</a>
    <h1 class="mt-6 mb-8 font-display text-[clamp(34px,4vw,46px)] font-normal text-ink">{privacy.title}</h1>
    <div class="max-w-[720px] space-y-5 text-[17px] leading-[1.75] text-soft">
      {privacy.paragraphs.map((p) => <p class="m-0">{p}</p>)}
    </div>
  </main>
</Layout>

