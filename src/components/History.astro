---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Photo from '@/components/ui/Photo.astro';
import { site } from '@/config/site';
import { history } from '@/data/content';
---

<section id="historia" class="section-hairline pattern-diamond bg-fixed-desktop bg-cream">
  <div class="container-site flex flex-wrap items-center gap-10 py-14 md:py-[72px] lg:gap-16 lg:py-24">
    <div class="relative min-w-0 flex-[1_1_420px]">
      <Photo
        src={site.photos.facade}
        alt={history.photoAlt}
        placeholder={history.photoPlaceholder}
        class="fx-up h-80 rounded-2xl bg-ph shadow-photo md:h-[420px] lg:h-[520px]"
      />
      <div
        class="glass absolute bottom-6 left-6 rounded-xl border border-badge-border bg-badge px-5 py-4 shadow-glass [--glass-blur:12px]"
      >
        <div class="text-xs font-bold tracking-[0.18em] text-trust-icon uppercase">{history.badgeEyebrow}</div>
        <div class="mt-1 font-display text-xl text-trust-ink">{history.badgeText}</div>
      </div>
    </div>

    <div class="fx-rise min-w-0 flex-[1_1_460px]">
      <Eyebrow>{history.eyebrow}</Eyebrow>
      <h2 class="title-glow m-0 mb-6 font-display text-[clamp(34px,4vw,46px)] leading-[1.2] font-normal text-ink">
        {history.title}
      </h2>
      {
        history.paragraphs.map((p, i) => (
          <p class:list={['m-0 text-[17px] leading-[1.75] text-soft', i === history.paragraphs.length - 1 ? 'mb-8' : 'mb-5']}>
            {p}
          </p>
        ))
      }
      <blockquote
        class="glass m-0 mb-8 rounded-xl border border-quote-border bg-quote px-6 py-5 font-display text-[21px] leading-[1.45] text-ink italic [--glass-blur:8px]"
      >
        {history.quote}
      </blockquote>
      <dl class="m-0 grid grid-cols-3 gap-4 border-t border-stats-line pt-7">
        {
          history.stats.map((s) => (
            <div class="flex flex-col">
              <dt class="order-2 text-sm text-soft">{s.label}</dt>
              <dd class="text-stat order-1 m-0 font-display text-[34px] text-gold">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
