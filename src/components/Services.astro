---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import { services, ui } from '@/data/content';
import { waLink } from '@/lib/whatsapp';
---

<section id="servicios" class="section-hairline pattern-dots bg-fixed-desktop bg-cream">
  <div class="container-site py-14 md:py-[72px] lg:py-24">
    <div class="mb-14 text-center">
      <Eyebrow>{services.eyebrow}</Eyebrow>
      <h2 class="title-glow m-0 mb-4 font-display text-[clamp(34px,4vw,46px)] font-normal text-ink">{services.title}</h2>
      <p class="mx-auto my-0 max-w-[620px] text-[17px] leading-[1.7] text-soft">{services.intro}</p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-6">
      {
        services.items.map((s) => (
          <article class="lift fx-rise glass flex flex-col gap-3 rounded-2xl border border-quote-border bg-card p-8 shadow-card [--glass-blur:12px]">
            <div class="icon-disc flex size-[52px] items-center justify-center rounded-full bg-icon-disc text-gold">
              <Icon name="gem" size={24} strokeWidth={1.6} />
            </div>
            <h3 class="m-0 font-display text-2xl font-normal">{s.title}</h3>
            <p class="m-0 text-base leading-[1.65] text-soft">{s.body}</p>
            <a
              href={waLink(s.message)}
              target="_blank"
              rel="noopener"
              aria-label={`${services.cta} sobre ${s.title} ${ui.opensWhatsApp}`}
              class="mt-auto inline-flex min-h-11 items-center text-[15px] font-bold text-wa-link hover:text-wa-link"
            >
              {services.cta} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
