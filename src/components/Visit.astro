---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { visit, ui } from '@/data/content';
---

<section id="visitanos" class="section-hairline bg-glow bg-bg">
  <div class="container-site flex flex-wrap gap-12 py-14 md:py-[72px] lg:py-24">
    <div class="min-w-0 flex-[999_1_560px]">
      <Eyebrow>{visit.eyebrow}</Eyebrow>
      <h2 class="title-glow m-0 mb-4 font-display text-[clamp(34px,4vw,46px)] font-normal text-ink">{visit.title}</h2>
      <p class="m-0 mb-7 text-[17px] leading-[1.7] text-soft">{visit.intro}</p>
      {
        site.maps.embedUrl ? (
          <iframe
            src={site.maps.embedUrl}
            title={visit.mapLabel}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="fx-rise block h-[280px] w-full rounded-2xl border-0 shadow-map md:h-[400px]"
          />
        ) : (
          <div
            role="img"
            aria-label={visit.mapLabel}
            class="fx-rise flex h-[280px] items-center justify-center rounded-2xl bg-ph2 text-sm text-ph-ink shadow-map md:h-[400px]"
          >
            <span aria-hidden="true">{visit.mapPlaceholder}</span>
          </div>
        )
      }
    </div>

    <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 self-end">
      {
        visit.cards.map((v) => (
          <div class="fx-rise flex items-start gap-4 rounded-[14px] border border-card-border-soft bg-card-solid p-5 shadow-card">
            <div class="icon-disc flex size-11 shrink-0 items-center justify-center rounded-full bg-icon-disc text-gold">
              <Icon name="pin" size={20} strokeWidth={1.7} />
            </div>
            <div>
              <div class="text-base font-bold">{v.title}</div>
              <div class="mt-1 text-[15px] leading-normal text-soft">{v.body}</div>
            </div>
          </div>
        ))
      }
      <a
        href={site.maps.directionsUrl}
        target="_blank"
        rel="noopener"
        class="flex min-h-[52px] items-center justify-center rounded-md border border-ghost-border text-base font-bold text-ghost-ink no-underline hover:text-ghost-ink"
      >
        {ui.directions}<span class="sr-only"> {ui.opensMaps}</span>
      </a>
    </div>
  </div>
</section>
