---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import { clients, messages, ui } from '@/data/content';
import { waLink } from '@/lib/whatsapp';
---

<section id="clientes" class="section-hairline bg-glow relative overflow-hidden bg-bg">
  <div
    aria-hidden="true"
    class="fx-down pointer-events-none absolute top-10 right-[4%] font-display text-[520px] leading-[0.8] text-quote-glyph max-md:hidden"
  >
    ”
  </div>
  <div class="container-site relative py-14 md:py-[72px] lg:py-24">
    <div class="mb-14 text-center">
      <Eyebrow>{clients.eyebrow}</Eyebrow>
      <h2 class="title-glow m-0 mb-4 font-display text-[clamp(34px,4vw,46px)] font-normal text-ink">{clients.title}</h2>
      <p class="mx-auto my-0 max-w-[600px] text-[17px] leading-[1.7] text-soft">{clients.intro}</p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-5">
      {
        clients.types.map((c) => (
          <article class="lift fx-rise glass flex flex-col gap-2.5 rounded-[14px] border border-card-border-soft bg-card p-7 shadow-card [--glass-blur:8px]">
            <div class="icon-disc flex size-12 items-center justify-center rounded-full bg-icon-disc text-gold">
              <Icon name="user" size={22} strokeWidth={1.6} />
            </div>
            <h3 class="m-0 font-display text-[22px] font-normal">{c.title}</h3>
            <p class="m-0 text-[15px] leading-[1.6] text-soft">{c.body}</p>
          </article>
        ))
      }
    </div>

    <div
      class="fx-rise pattern-band bg-fixed-desktop mt-6 flex flex-wrap items-center justify-between gap-6 rounded-2xl bg-band px-[22px] py-7 text-on-dark shadow-band md:px-8 md:py-10"
    >
      <div class="min-w-0 flex-[1_1_420px]">
        <h3 class="m-0 mb-2 font-display text-[28px] font-normal">{clients.band.title}</h3>
        <p class="m-0 text-base leading-[1.6] text-on-dark-soft">{clients.band.body}</p>
      </div>
      <a
        href={waLink(messages.wholesaleQuote)}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-[52px] items-center justify-center rounded-md bg-gold-light px-[26px] text-base font-bold text-ink-fixed no-underline shadow-wa hover:text-ink-fixed max-md:w-full"
      >
        {clients.band.cta}<span class="sr-only"> {ui.opensWhatsApp}</span>
      </a>
    </div>

    <div class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-6">
      {
        clients.reviews.map((r) => (
          <figure class="fx-rise glass m-0 flex flex-col gap-4 rounded-[14px] bg-review p-7 shadow-card [--glass-blur:8px]">
            <blockquote class="m-0 text-base leading-[1.7] text-muted">{r.quote}</blockquote>
            <figcaption class="text-sm text-soft">
              <strong class="text-ink">{r.name}</strong> · {r.kind}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
